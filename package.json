{
  "name": "mob-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Custom CRM for physician-owned medical office building owner prospecting",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "extract": "python3 scripts/extract.py data/source_snapshot.xlsx data/seed.json",
    "import": "node scripts/import.js",
    "import:reset": "node scripts/import.js --reset",
    "seed:comps": "python3 scripts/extract_sale_comps.py && node scripts/seed_sale_comps.js",
    "fetch:sales": "node scripts/fetch_public_sales.js",
    "import:comps": "node scripts/import_comps_csv.js",
    "import:ages": "node scripts/import_owner_ages.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
